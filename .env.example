# ── Site ────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Used for metadataBase, sitemap, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sample-catalog switch ───────────────────────────────────────────────
# Keep "true" until the owner confirms real prices/stock. While true, the UI
# shows a "sample prices" notice and Product JSON-LD is suppressed.
NEXT_PUBLIC_SAMPLE_CATALOG=true

# ── Contact (leave empty to hide the element entirely) ──────────────────
# WhatsApp number in international format, digits only (e.g. 201000000000).
# The floating WhatsApp button renders only when this is set.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ADDRESS_AR=

# ── Social links (rendered only when non-empty) ─────────────────────────
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# ── Payments ────────────────────────────────────────────────────────────
# InstaPay stays disabled until a handle is confirmed.
NEXT_PUBLIC_INSTAPAY_ENABLED=false
NEXT_PUBLIC_INSTAPAY_HANDLE=

# ── Admin (server-only, never exposed to the browser) ───────────────────
# Session signing key. REQUIRED in production — the server refuses to sign
# admin sessions without it. Generate one:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Login credentials. Change both before going live.
# Defaults when unset: admin@alsuliman.local / alsuliman-dev (dev only).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: newsletter signup webhook. Newsletter form stays disabled when empty.
NEWSLETTER_WEBHOOK_URL=
